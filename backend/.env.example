# Copy this file to .env in the backend folder and replace both values.
# Never commit backend/.env or share these values publicly.
# Use a unique developer code of at least 8 characters.
LUNA_DEV_CODE=replace-with-your-private-code
# Use a random secret of at least 32 characters for signing one-hour sessions.
LUNA_DEV_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
